type Value = 
 variant {
   "bool": bool;
   float: float64;
   "int": int;
   "nat": nat;
   "null";
   "text": text;
 };
type UserRole = 
 variant {
   admin;
   guest;
   user;
 };
type Result__1 = 
 record {
   hasMore: bool;
   rows: vec vec Cell;
 };
type Result_4 = 
 variant {
   err: Error;
   ok;
 };
type Result_3 = 
 variant {
   err: text;
   ok: AdminInviteResult;
 };
type Result_2 = 
 variant {
   err: text;
   ok: vec AdminEmailInfo;
 };
type Result_1 = 
 variant {
   err: text;
   ok: NotificationStatus;
 };
type Result = 
 variant {
   err: text;
   ok;
 };
type OrderDetails = 
 record {
   businessName: opt text;
   deliveryAddress: opt text;
   deliveryFrequency: opt text;
   deliveryTimeWindow: opt text;
   desiredDeliveryDays: vec text;
   estimatedWeeklyUsage: opt text;
   eventDate: opt text;
   iceType: opt text;
   message: opt text;
   onSiteFreezer: opt bool;
   totalBags: opt text;
   venueName: opt text;
 };
type NotificationStatus = 
 record {
   lastAttemptAt: opt int;
   lastError: opt text;
   lastSuccessAt: opt int;
   recipients: vec text;
 };
type InquiryType = 
 variant {
   Event;
   General;
   Wholesale;
 };
type InquiryStatus = 
 variant {
   Contacted;
   Fulfilled;
   InReview;
   New;
 };
type Inquiry = 
 record {
   address: opt text;
   businessName: opt text;
   email: text;
   id: nat;
   inquiryType: InquiryType;
   name: text;
   notes: opt text;
   orderDetails: OrderDetails;
   phone: text;
   status: InquiryStatus;
   timestamp: int;
 };
type Error = 
 variant {
   AmbiguousAttribute: record {
                         field: text;
                         sources: vec text;
                       };
   FrontendOriginMismatch: record {
                             expected: vec text;
                             got: text;
                           };
   FrontendOriginsNotConfigured;
   MalformedCandid;
   MissingField: text;
   MixedSsoSources: record {
                      otherKeys: vec text;
                      ssoKeys: vec text;
                    };
   NoAttributes;
   Stale: record {ageNs: nat;};
   UnknownNonce;
   UntrustedSsoSource: record {domain: text;};
 };
type Cell = 
 record {
   name: text;
   value: Value;
 };
type AdminStatus = 
 variant {
   active;
   pending;
 };
type AdminSessionInfo = 
 record {
   email: text;
   isPrimary: bool;
 };
type AdminInviteResult = 
 record {
   email: text;
   emailError: opt text;
   emailed: bool;
   expiresAt: int;
   setupCode: text;
 };
type AdminEmailInfo = 
 record {
   addedAt: int;
   addedBy: text;
   email: text;
   isPrimary: bool;
   status: AdminStatus;
 };
service : {
  _initialize_access_control: () -> ();
  _internet_identity_sign_in_finish: () -> (Result_4);
  _internet_identity_sign_in_start: () -> (blob);
  activateAdminAccount: (email: text, setupCode: text, password: text) ->
   (Result);
  addAdminEmail: (token: text, newEmail: text) -> (Result_3);
  assignCallerUserRole: (user: principal, role: UserRole) -> ();
  execute: (qJson: text) -> (Result__1) query;
  exportInquiries: () -> (vec Inquiry) query;
  getAdminEmails: (token: text) -> (Result_2) query;
  getAdminSession: (token: text) -> (opt AdminSessionInfo) query;
  getCallerUserRole: () -> (UserRole) query;
  getInquiry: (id: nat) -> (opt Inquiry) query;
  getInquiryCount: (token: text) -> (nat) query;
  getNotificationStatus: (token: text) -> (Result_1) query;
  isAuthenticated: (token: text) -> (bool) query;
  isCallerAdmin: () -> (bool) query;
  listInquiries: (token: text) -> (vec Inquiry) query;
  login: (email: text, password: text) -> (opt text);
  logout: (token: text) -> ();
  needsInitialSetup: () -> (bool) query;
  removeAdminEmail: (token: text, targetEmail: text) -> (Result);
  schema: () -> (text) query;
  sendTestNotification: (token: text) -> (Result);
  setupPassword: (password: text) -> (bool);
  submitInquiry: (inquiry: Inquiry) -> (nat);
  updateInquiry: (token: text, id: nat, status: InquiryStatus, notes:
   opt text) -> (opt Inquiry);
  updateInquiryStatus: (id: nat, status: InquiryStatus, notes: opt text) ->
   (opt Inquiry);
  verifyAdminAccess: (email: text) -> (bool) query;
}
